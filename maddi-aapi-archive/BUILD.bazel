load("//:java_library_conventions.bzl", "maddi_java_library")

maddi_java_library(
    name = "maddi-aapi-archive",
    srcs = glob(["src/main/java/**/*.java"]),
     javacopts = [
                "-Xep:EqualsHashCode:WARN",
            ],
    visibility = ["//visibility:public"],  # or ["//visibility:private"] for internal-only
    resources = glob(["src/main/resources/**/*"]),
    deps = [
        "//maddi-support",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@maven//:ch_qos_logback_logback_classic",
        # Gradle's compileOnly: the libraries whose types the hints name (parsed by the hints compiler, never run)
        "@maven//:org_jetbrains_kotlin_kotlin_stdlib",
        "@maven//:io_vavr_vavr",
        "@maven//:org_eclipse_collections_eclipse_collections_api",
        "@maven//:org_eclipse_collections_eclipse_collections",
        "@maven//:com_google_guava_guava",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_hamcrest_hamcrest",
        "@maven//:org_junit_jupiter_junit_jupiter_params",
        "@maven//:org_mockito_mockito_core",
        "@maven//:commons_io_commons_io",
        "@maven//:com_fasterxml_jackson_core_jackson_annotations",
        "@maven//:com_fasterxml_jackson_core_jackson_core",
        "@maven//:com_fasterxml_jackson_core_jackson_databind",
    ],
)
