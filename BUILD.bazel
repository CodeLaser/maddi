# Root BUILD file

load("@rules_java//toolchains:default_java_toolchain.bzl", "default_java_toolchain")

# Export platform configuration
exports_files(["platform.bzl", "java_library_conventions.bzl"])

# JDK 27 compile toolchain over the locally-installed JDK (see .bazelrc / MODULE.bazel).
# rules_java ships no hermetic remotejdk_27 yet; swap java_runtime to remotejdk_27 once it does.
default_java_toolchain(
    name = "java27_toolchain",
    source_version = "27",
    target_version = "27",
    java_runtime = "@local_jdk//:jdk",
)

# Package group for internal visibility
package_group(
    name = "internal",
    packages = ["//..."],
)
