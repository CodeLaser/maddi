common --enable_bzlmod

# The project targets JDK 27, as the Gradle build does (it compiles with the running JDK, and
# the committed JDK hint results are generated on 27). rules_java ships no hermetic
# remotejdk_27 yet, so we compile against the locally installed JDK 27 via a custom
# toolchain (//:java27_toolchain, registered in MODULE.bazel).
build --java_language_version=27
build --java_runtime_version=local_jdk
build --tool_java_language_version=27
build --tool_java_runtime_version=local_jdk

# @local_jdk is detected from JAVA_HOME at repo-fetch time, and CACHED: a JDK found once stays
# until the repository is re-fetched (a machine whose shell moved to 27 kept a JDK 21 this way).
# Pin it per-machine in an (uncommitted) user.bazelrc, and re-fetch after changing it
# (`bazel clean --expunge`):
#   common --repo_env=JAVA_HOME=/path/to/jdk-27
try-import %workspace%/user.bazelrc
