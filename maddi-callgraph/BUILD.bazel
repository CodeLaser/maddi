load("//:java_library_conventions.bzl", "maddi_java_library", "maddi_java_test")

# Not built by CI (which runs Gradle only); kept in step with build.gradle.kts by hand.
maddi_java_library(
    name = "maddi-callgraph",
    srcs = glob(["src/main/java/**/*.java"]),
    visibility = ["//visibility:public"],
    deps = [
        "//maddi-cst-analysis",
        "//maddi-cst-api",
        "//maddi-graph",
        "//maddi-inspection-api",
    ],
)

maddi_java_test(
    name = "maddi-callgraph_test",
    size = "small",
    srcs = glob(["src/test/java/**/*.java"]),
    test_packages = ["io.codelaser.maddi.callgraph"],
    deps = [
        ":maddi-callgraph",
        "//maddi-cst-api",
        "//maddi-cst-analysis",
        "//maddi-graph",
        "//maddi-inspection-api",
        "//maddi-inspection-integration",
        "//maddi-inspection-openjdk",
        "//maddi-inspection-resource",
        "//maddi-support",
    ],
)
