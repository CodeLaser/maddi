load("//:java_library_conventions.bzl", "maddi_java_library")

# the annotations (@Immutable, @NotModified, ...), split from maddi-support on 2026-08-05; maddi-support exports it,
# as Gradle's api(project(":maddi-annotation")) does
maddi_java_library(
    name = "maddi-annotation",
    srcs = glob(["src/main/java/**/*.java"]),
    visibility = ["//visibility:public"],
)
