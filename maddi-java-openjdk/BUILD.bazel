load("//:java_library_conventions.bzl", "maddi_java_library")
# module-info.java makes this a named module, so the javac-internals exports must
# target that module rather than ALL-UNNAMED (see maddi-java-openjdk/build.gradle.kts).
_MODULE = "io.codelaser.maddi.java.openjdk"

maddi_java_library(
    name = "maddi-java-openjdk",
    srcs = glob(["src/main/java/**/*.java"]),
    javacopts = [
        "--add-exports=jdk.compiler/com.sun.tools.javac.api=" + _MODULE,
        "--add-exports=jdk.compiler/com.sun.tools.javac.tree=" + _MODULE,
        "--add-exports=jdk.compiler/com.sun.tools.javac.code=" + _MODULE,
        "--add-exports=jdk.compiler/com.sun.tools.javac.parser=" + _MODULE,
        "--add-exports=jdk.compiler/com.sun.tools.javac.util=" + _MODULE,
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//maddi-cst-analysis",
        "//maddi-cst-api",
        "//maddi-cst-io",
        "//maddi-cst-print",
        "//maddi-graph",
        "//maddi-inspection-api",
        "//maddi-inspection-resource",
        "//maddi-java-parser",
        "//maddi-util",
    ],
)
