# JAXB as System.Xml.Serialization: the binding of a type is what JaxbXmlSerialization adds to it, a public property
# per bound field that carries XmlSerializer's attributes; the runtime is the compatibility library's (JavaXml.cs).
mapping jaxb:xml-serialization
compat JavaXml.cs
# the runtime: a context's types are bound by the properties JaxbXmlSerialization adds, read and written by XmlSerializer
