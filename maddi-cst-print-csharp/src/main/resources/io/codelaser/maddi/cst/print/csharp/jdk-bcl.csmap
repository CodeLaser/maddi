type java.util.SequencedCollection -> ICollection using System.Collections.Generic
# Java's Map and Set are implemented by hash and tree collections alike: C#'s interfaces. A HashMap is C#'s
# Dictionary; a LinkedHashMap keeps its insertion order, as OrderedDictionary does; an EnumMap iterates in
# the order of its keys, as SortedDictionary does.
type java.util.Map -> IDictionary using System.Collections.Generic
type java.util.AbstractMap -> IDictionary using System.Collections.Generic
type java.util.HashMap -> Dictionary using System.Collections.Generic
type java.util.IdentityHashMap -> Dictionary using System.Collections.Generic
# a WeakHashMap's keys are weak, which a Dictionary's are not: a key stays until it is removed
type java.util.WeakHashMap -> Dictionary using System.Collections.Generic
type java.util.concurrent.ConcurrentHashMap -> Dictionary using System.Collections.Generic
type java.util.LinkedHashMap -> OrderedDictionary using System.Collections.Generic
type java.util.EnumMap -> SortedDictionary using System.Collections.Generic
