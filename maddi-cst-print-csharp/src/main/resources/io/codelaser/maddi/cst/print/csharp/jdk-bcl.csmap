# The JDK as .NET's base class library: the C# counterparts of the JDK's types, members and fields, read by
# CSharpBcl. The rules it chooses per call, by an argument's or the receiver's type, are its Java choosers, which it
# asks before this file's rules, key by key. A template's syntax is LibraryMapping.Rule's; the compatibility
# library, Maddi.JavaCompat, is JavaCompat.cs.
mapping jdk

# ---------------------------------------------------------------- types
# C#'s List, the concrete type: its IList does not implement IReadOnlyList, which the covariant List<? extends T>
# is (see CSharpTypeName)
type java.util.List -> List using System.Collections.Generic
type java.util.ArrayList -> List using System.Collections.Generic
