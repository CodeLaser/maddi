type java.util.HashSet -> HashSet using System.Collections.Generic
type java.util.LinkedHashSet -> HashSet using System.Collections.Generic
type java.util.TreeSet -> SortedSet using System.Collections.Generic
type java.util.SortedSet -> SortedSet using System.Collections.Generic
