# slf4j as Microsoft.Extensions.Logging: a Logger is an ILogger, a message with {} holes a message template whose
# holes are named after their arguments ("output: {}", x is "output: {X}"), a trailing exception the first argument.
# LoggerFactory.getLogger is the compatibility library's JavaLogging, whose factory the application sets.
mapping slf4j:ms-logging
nuget Microsoft.Extensions.Logging.Abstractions 10.0.0
compat JavaLogging.cs
type org.slf4j.Logger -> ILogger using Microsoft.Extensions.Logging
member org.slf4j.LoggerFactory.getLogger(Class) -> JavaLogging.GetLogger($1) using Maddi.JavaCompat
member org.slf4j.LoggerFactory.getLogger(String) -> JavaLogging.GetLogger($1) using Maddi.JavaCompat
member org.slf4j.Logger.getName/0 -> $0.ToString()
# trace: the exception first, then the message and its arguments
member org.slf4j.Logger.trace(String) -> $0.LogTrace($#1) using Microsoft.Extensions.Logging
member org.slf4j.Logger.trace(String,Throwable) -> $0.LogTrace($2, $#1) using Microsoft.Extensions.Logging
member org.slf4j.Logger.trace/2 ?arguments=2 ?lastArgumentThrowable -> $0.LogTrace($2, $#1) using Microsoft.Extensions.Logging
member org.slf4j.Logger.trace/2 ?arguments=2 -> $0.LogTrace($#1, $2) using Microsoft.Extensions.Logging
member org.slf4j.Logger.trace/2 ?arguments=3 ?lastArgumentThrowable -> $0.LogTrace($3, $#1, $2) using Microsoft.Extensions.Logging
member org.slf4j.Logger.trace/2 ?arguments=3 -> $0.LogTrace($#1, $2, $3) using Microsoft.Extensions.Logging
member org.slf4j.Logger.trace/2 ?arguments=4 ?lastArgumentThrowable -> $0.LogTrace($4, $#1, $2, $3) using Microsoft.Extensions.Logging
member org.slf4j.Logger.trace/2 ?arguments=4 -> $0.LogTrace($#1, $2, $3, $4) using Microsoft.Extensions.Logging
member org.slf4j.Logger.trace/2 ?arguments=5 ?lastArgumentThrowable -> $0.LogTrace($5, $#1, $2, $3, $4) using Microsoft.Extensions.Logging
member org.slf4j.Logger.trace/2 ?arguments=5 -> $0.LogTrace($#1, $2, $3, $4, $5) using Microsoft.Extensions.Logging
member org.slf4j.Logger.trace/2 -> $0.LogTrace($*) using Microsoft.Extensions.Logging
member org.slf4j.Logger.trace/3 ?arguments=3 ?lastArgumentThrowable -> $0.LogTrace($3, $#1, $2) using Microsoft.Extensions.Logging
member org.slf4j.Logger.trace/3 ?arguments=3 -> $0.LogTrace($#1, $2, $3) using Microsoft.Extensions.Logging
member org.slf4j.Logger.trace/3 -> $0.LogTrace($*) using Microsoft.Extensions.Logging
member org.slf4j.Logger.isTraceEnabled/0 -> $0.IsEnabled(LogLevel.Trace) using Microsoft.Extensions.Logging
