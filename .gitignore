MODULE.bazel.lock
bazel-*
.run
**/.DS_Store
**/build/
**/target/
*/bin/
**/.gradle/
**/out/
.idea
**/.idea
*.iml
*/.kotlin

# IntelliJ Platform Gradle Plugin runIde sandbox
.intellijPlatform/

# per-machine bazel config (JAVA_HOME pin etc.)
user.bazelrc

# machine-specific, non-deterministic generated input config (written to build/ by TestJavacTimefoldSolverCore)
maddi-run-openjdk/src/test/resources/inputConfiguration/timefold-solver.json
.githooks/internal-names.txt

# per-machine corpus config (task corpus:init)
corpus/.env
